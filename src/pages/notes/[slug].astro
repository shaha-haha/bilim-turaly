---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const entries=await getCollection('notes',({data})=>!data.draft);return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}><article class="reading"><header class="article-head"><span class="eyebrow">Зерттеу жазбасы</span><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p></header><div class="article-body"><Content/></div></article></Base>
