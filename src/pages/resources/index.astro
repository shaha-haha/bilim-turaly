---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';
const resources=(await getCollection('resources',({data})=>!data.draft)).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
---
<Base title="Материалдар"><div class="wrap"><header class="page-head"><span class="eyebrow">Teaching resources</span><h1 class="page-title">Материалдар</h1><p class="lede">Сабақта қолдануға арналған құралдар, үлгілер және тапсырмалар. Қазір кітапханаға алғашқы материалдар қосылып жатыр.</p></header><div class="resource-controls"><input id="search" type="search" placeholder="Материалды іздеу…" aria-label="Материалды іздеу"/><select id="grade" aria-label="Сынып бойынша сүзу"><option value="">Барлық сыныптар</option><option value="6">6-сынып</option><option value="7">7-сынып</option><option value="8">8-сынып</option><option value="Барлығы">Барлығы</option></select><select id="language" aria-label="Тіл бойынша сүзу"><option value="">Барлық тілдер</option><option value="Қазақша">Қазақша</option><option value="English">English</option><option value="Русский">Русский</option></select></div><div id="resources">{resources.map((entry)=> <article class="resource-card" data-title={entry.data.title.toLowerCase()} data-grade={entry.data.grade} data-language={entry.data.language}><span class="meta">{entry.data.grade}-сынып · {entry.data.language} · {entry.data.type}</span><h2>{entry.data.title}</h2><p>{entry.data.description}</p>{entry.data.file&&<a class="download" href={entry.data.file} download>Материалды жүктеу ↓</a>}</article>)}</div><p class="empty" id="no-results" hidden>Сұраныс бойынша материал табылмады.</p></div><script>const search=document.querySelector<HTMLInputElement>('#search');const grade=document.querySelector<HTMLSelectElement>('#grade');const language=document.querySelector<HTMLSelectElement>('#language');const cards=[...document.querySelectorAll<HTMLElement>('.resource-card')];function filter(){let shown=0;for(const card of cards){const match=card.textContent?.toLowerCase().includes(search?.value.toLowerCase()||'')&&(!grade?.value||card.dataset.grade===grade.value||card.dataset.grade==='Барлығы')&&(!language?.value||card.dataset.language===language.value);card.hidden=!match;if(match)shown++}const empty=document.querySelector<HTMLElement>('#no-results');if(empty)empty.hidden=shown>0}search?.addEventListener('input',filter);grade?.addEventListener('change',filter);language?.addEventListener('change',filter);</script></Base>
