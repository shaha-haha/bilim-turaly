---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){const entries=await getCollection('essays',({data})=>!data.draft);return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);
const date=new Intl.DateTimeFormat('kk-KZ',{day:'numeric',month:'long',year:'numeric'}).format(entry.data.date);
---
<Base title={entry.data.title} description={entry.data.description}><article class="reading"><header class="article-head"><span class="eyebrow">{entry.data.category} · {date}</span><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p><div>{entry.data.tags.map((t:string)=><span class="tag">{t}</span>)}</div></header><div class="article-body"><Content/></div></article></Base>
